# ---------------------------------------------------------------------
# NODO CANONICO: el que NO aplica BIP-110 (Bitcoin Core).
#
# Sigue la cadena mayoritaria pase lo que pase, asi que es el que responde
# por defecto en todos los endpoints. No pongas aqui un nodo Knots con
# reduced_data: a partir del bloque 961.632 puede irse a la cadena
# minoritaria y el panel lo contaria como si fuese la cadena.
#
# Para comprobar cual es cual:
#   bitcoin-cli getnetworkinfo    -> mira si localservicesnames trae REDUCED_DATA
#   bitcoin-cli getdeploymentinfo -> mira si existe el despliegue reduced_data
#
# Se pueden poner LAS DOS direcciones. Se usa una sola, la primera que
# responda, y si deja de responder se prueba la otra. Clearnet primero
# porque es mucho mas rapida: desde un VPS fallara en unos segundos y se
# quedara en Tor sin que haya que tocar nada.
# ---------------------------------------------------------------------
# Con esquema: http:// delante. Sin el, curl funciona (lo asume) pero las
# librerias no, asi que el panel lo añade solo si falta.
BTC_RPC_URL=http://192.168.1.50:8332
# BTC_RPC_TOR_URL=http://tuservicioocultoxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.onion:8332

BTC_RPC_USER=tu_usuario_rpc
BTC_RPC_PASSWORD=tu_password_rpc

# ---------------------------------------------------------------------
# NODO BIP-110 (Bitcoin Knots con reduced_data). Opcional.
#
# Sin el, el panel funciona igual pero /api/chain no puede comparar y no
# hay forma de detectar la separacion tras el bloque 961.632.
# Si no pones usuario y clave propios se reutilizan los de arriba.
#
# OJO: que NO sea la misma direccion que el canonico. Se compararia un
# nodo consigo mismo, todo saldria en verde y no detectaria nunca una
# separacion. /api/health avisa de esto.
# ---------------------------------------------------------------------
# BTC_RPC_URL_KNOTS=http://192.168.1.51:8332
# BTC_RPC_TOR_URL_KNOTS=http://otroservicioocultoxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.onion:8332
# BTC_RPC_USER_KNOTS=
# BTC_RPC_PASSWORD_KNOTS=

# Cuanto se recuerda la direccion elegida. Se invalida igualmente en cuanto
# una llamada falla, asi que un corte se recupera en la siguiente peticion.
# RPC_PICK_TTL=120
# Timeout del sondeo inicial en clearnet. Tiene que fallar rapido.
# RPC_PROBE_TIMEOUT=6

# ---------------------------------------------------------------------
# Sondeo del P2P (muestra sesgada, ver crawler.py)
#
# CRAWL_VIA_TOR=true saca TODO el sondeo por Tor: no expone la IP del VPS,
# pero es bastante mas lento. En false, IPv4 e IPv6 salen en claro desde el
# VPS y solo las .onion pasan por Tor.
# ---------------------------------------------------------------------
CRAWL_VIA_TOR=false
CRAWL_MAX_NODES=250

# Incluir nodos .onion en el sondeo. Hay Tor "arriba" si se cumple
# cualquiera de estas tres: CRAWL_VIA_TOR=true, la url del nodo apunta a un
# .onion, o simplemente hay un SOCKS escuchando en TOR_HOST:TOR_PORT.
#
# Lo tercero se comprueba abriendo el puerto, no deduciendolo de la
# configuracion. Importa cuando el nodo esta en onlynet=onion: entonces no
# tiene ni un peer clearnet, y si ademas se descartan las semillas .onion
# el sondeo se queda sin nada que hacer teniendo Tor delante.
CRAWL_INCLUDE_ONION=true

# Semillas tomadas de getpeerinfo de los nodos propios.
CRAWL_MAX_SEEDS=60

# Vacio = automatico segun si se sale por Tor. Solo tocar si hace falta.
# CRAWL_THREADS=16
# CRAWL_TIMEOUT=8
# CRAWL_BUDGET=180

# Proxy SOCKS de Tor. Dentro del contenedor lo levanta el propio entrypoint.
# TOR_HOST=127.0.0.1
# TOR_PORT=9050
# TOR_SOCKS=socks5h://127.0.0.1:9050

# i2p y cjdns NO se sondean: harian falta routers propios de esas redes,
# que este contenedor no lleva. La muestra lo dice en pantalla.

# ---------------------------------------------------------------------
# Muestras
# ---------------------------------------------------------------------
# Bloques recientes para estimar la cuota de cada pool.
# Mas muestra = mas precision pero mas lento (mucho mas lento por Tor).
POOLS_SAMPLE=500

# Bloques por peticion al pedir coinbase. Medido: getblock verbosity=1 de un
# bloque actual son unos 250 KB, asi que un lote grande pide decenas de MB y
# por Tor se corta. Vacio = 15 por Tor, 60 en claro. No subirlo sin medir.
# POOLS_CHUNK=

# Periodos de retarget cerrados que se muestran. Se cachean en disco para
# siempre, porque un periodo cerrado es inmutable.
HISTORY_PERIODS=5

# Tope de espera de /api/health. Un endpoint de salud que tarda medio
# minuto no sirve: el supervisor da por muerto un contenedor que esta vivo.
# Los dos nodos se consultan en paralelo, asi que este es el total.
# Por Tor la latencia varia mucho de una peticion a otra, asi que el
# tope va con la ruta: si hay alguna .onion configurada se usa el de Tor.
HEALTH_TIMEOUT=12
HEALTH_TIMEOUT_TOR=35

# ---------------------------------------------------------------------
# Cache en memoria (segundos)
# ---------------------------------------------------------------------
MINERS_TTL=300
POOLS_TTL=3600
NODES_TTL=3600
HISTORY_TTL=3600
# Comparacion de cadenas: barata (unas 20 llamadas), puede ir muy fresca.
CHAINS_TTL=60

# ---------------------------------------------------------------------
# Persistencia. Aqui viven los periodos cerrados y la altura de separacion,
# que NO se puede perder: es un hecho historico. En Docker es un volumen.
# ---------------------------------------------------------------------
# CACHE_DIR=/data
